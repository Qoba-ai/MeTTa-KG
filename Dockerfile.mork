FROM rustlang/rust:nightly-bookworm

RUN apt-get update && apt-get install -y git cmake

RUN git clone --branch fix/server-graft-api-update https://github.com/icog-labs-dev/MORK.git /app

WORKDIR /app

# Clone the PathMap dependency to the absolute path expected by the manifest
RUN git clone --branch stable https://github.com/Adam-Vandervorst/PathMap.git /PathMap

RUN cargo build --release -p mork-server --bin mork-server

EXPOSE 8001

CMD ["./target/release/mork-server"]
