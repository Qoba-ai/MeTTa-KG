# Backend Environment Variables
# Copy this file to .env and update values for your environment
# Note: Frontend variables are in frontend/.env.example

# Database connection
POSTGRES_USER=metta-kg-admin
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=metta-kg
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Service communication (internal)
METTA_KG_MORK_URL=http://mork:8001

# CORS configuration - allowed frontend origins
# For local development:
METTA_KG_FRONTEND_URL=http://localhost:5173

# For production with Vercel:
# METTA_KG_FRONTEND_URL=https://your-app.vercel.app

# Mork configuration
MORK_SERVER_ADDR=0.0.0.0
MORK_SERVER_PORT=8001
